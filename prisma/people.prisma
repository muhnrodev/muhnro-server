model TeamMember {
    id                      String   @id @default(dbgenerated("gen_random_uuid()"))
    fullName                String
    email                   String   @unique
    phone                   String?
    department              String?
    employmentType          EmploymentType
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    projects                Project[]
    projectMembers          ProjectTeamMember[]
    projectNotes            ProjectNote[]
}

model TeamRole {
    id                      String   @id @default(dbgenerated("gen_random_uuid()"))
    roleName                String   @unique
    description             String
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    projectMembers          ProjectTeamMember[]
}

model Client {
    id                      String   @id @default(dbgenerated("gen_random_uuid()"))
    name                    String
    description             String?
    industryId              String
    addressId               String?
    notes                   String?
    logoId                  String?
    stakeholderId           String?
    email                   String?
    phone                   String?

    isDeleted               Boolean         @default(false)
    createdAt               DateTime        @default(now())
    updatedAt               DateTime        @updatedAt
    deletedAt               DateTime?

    logo                    Media?          @relation(fields: [logoId], references: [id])
    stakeholder             Stakeholder?    @relation(fields: [stakeholderId], references: [stakeholderId])
    address                 ClientAddress?  @relation(fields: [addressId], references: [id], onDelete: Cascade)
    industry                Industry        @relation(fields: [industryId], references: [industryId])

    projects                Project[]
    contacts                ClientContact[]

    @@unique([name, stakeholderId])
    @@index([industryId])
    @@index([stakeholderId])
    @@index([isDeleted, createdAt])
    @@index([email])
    @@index([phone])
}

model ClientContact {
    id                      String   @id @default(dbgenerated("gen_random_uuid()"))
    clientId                String
    fullName                String
    email                   String
    phone                   String?
    stakeholderId           String?

    createdAt               DateTime        @default(now())
    updatedAt               DateTime        @updatedAt
    isPrimary               Boolean         @default(false)
    isDeleted               Boolean         @default(false)

    client                  Client          @relation(fields: [clientId], references: [id])
    stakeholder             Stakeholder?    @relation(fields: [stakeholderId], references: [stakeholderId])
}

model ClientAddress {
    id                      String   @id @default(dbgenerated("gen_random_uuid()"))
    clientId                String
    addressLine1            String
    addressLine2            String?
    city                    String
    state                   String
    postalCode              String?
    country                 String
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    clients                 Client[]
}

model Author {
    authorId            String   @id @default(dbgenerated("gen_random_uuid()"))
    fullName            String
    email               String   @unique
    bio                 String?
    organizationId      String?
    avatarImageId       String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    organization        Organization? @relation(fields: [organizationId], references: [organizationId])
    avatarImage         AvatarImage?  @relation(fields: [avatarImageId], references: [imageId])

    articles            ArticleAuthor[]
    reportAuthors       ReportAuthor[]
}

model Organization {
    organizationId String   @id @default(dbgenerated("gen_random_uuid()"))
    name           String
    type           String
    websiteURL     String
    createdAt      DateTime @default(now())

    authors        Author[]
}

model ArticleAuthor {
    id        String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId String
    authorId  String
    role      String

    article   Article @relation(fields: [articleId], references: [articleId])
    author    Author  @relation(fields: [authorId], references: [authorId])
}

model ReportAuthor {
    id        String   @id @default(dbgenerated("gen_random_uuid()"))
    reportId  String
    authorId  String
    role      String

    report    Report @relation(fields: [reportId], references: [reportId])
    author    Author @relation(fields: [authorId], references: [authorId])
}

model Stakeholder {
    stakeholderId                   String   @id @default(dbgenerated("gen_random_uuid()"))
    name                            String
    organization                    String
    email                           String?
    phone                           String?
    type                            StakeholderType

    createdAt                       DateTime @default(now())
    updatedAt                       DateTime @updatedAt
    isDeleted                       Boolean  @default(false)
    deletedAt                       DateTime?

    projectStakeholders             ProjectStakeholder[]
    clients                         Client[]
    clientContacts                  ClientContact[]

    @@index([name])
    @@index([organization])
    @@index([email])
    @@index([phone])
    @@index([type])
    @@index([isDeleted, createdAt])
}
