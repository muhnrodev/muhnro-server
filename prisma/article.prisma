model Article {
    articleId           String   @id @default(dbgenerated("gen_random_uuid()"))
    slug                String   @unique
    title               String
    subtitle            String?
    summary             String?  @db.Text
    content             Json
    status              ContentStatus @default(DRAFT)
    scheduledPublish    DateTime?
    publishedAt         DateTime?
    unpublishedAt       DateTime?
    readingTime         Int
    wordCount           Int
    featuredImageId     String
    projectId           String?
    industryId          String?

    createdById         String
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    // project             Project?    @relation(fields: [projectId], references: [id])
    featuredImage       Media       @relation(fields: [featuredImageId], references: [id])
    createdBy           User        @relation(fields: [createdById], references: [id])
    industry            Industry?   @relation(fields: [industryId], references: [industryId])

    topics              ArticleTopic[]
    serviceActivities   ArticleServiceActivity[]
    tags                ArticleTag[]
    authors             ArticleAuthor[]
    images              ArticleImage[]
    references          ArticleReference[]
    versions            ArticleVersion[]
    comments            ArticleComment[]
}


model ArticleTopic {
    id        String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId String
    topicId   String

    article   Article @relation(fields: [articleId], references: [articleId])
    topic     Topic   @relation(fields: [topicId], references: [topicId])
}

model ArticleServiceActivity {
    id         String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId  String
    activityId String

    article         Article         @relation(fields: [articleId], references: [articleId])
    serviceActivity ServiceActivity @relation(fields: [activityId], references: [activityId])
}

model ArticleTag {
    id              String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId       String
    tagId           String

    tag             Tag     @relation(fields: [tagId], references: [tagId])
    article         Article @relation(fields: [articleId], references: [articleId])
}

model ArticleReference {
    referenceId     String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId       String
    title           String
    url             String
    publisher       String
    publishedAt     DateTime?
    accessedAt      DateTime?

    article         Article @relation(fields: [articleId], references: [articleId])
}

model ArticleVersion {
    versionId       String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId       String
    versionNumber   Int
    body            String   @db.Text
    changeLog       String?
    createdBy       String
    createdAt       DateTime @default(now())


    article         Article @relation(fields: [articleId], references: [articleId])
}

model ArticleComment {
    commentId       String   @id @default(dbgenerated("gen_random_uuid()"))
    articleId       String
    author          String
    body            String   @db.Text
    status          CommentStatus
    createdAt       DateTime @default(now())

    article         Article @relation(fields: [articleId], references: [articleId])
}