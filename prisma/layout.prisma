model Website {
    id                  String   @id @default(dbgenerated("gen_random_uuid()"))
    name                String
    description         String
    domain              String
    version             Int      @default(1)
    createdAt           DateTime @default(now())
    createdBy           String
    updatedAt           DateTime @updatedAt
    updatedBy           String

    pages               Webpage[]
}

model Webpage {
    id                  String   @id @default(dbgenerated("gen_random_uuid()"))
    websiteId           String
    slug                String
    
    createdAt           DateTime @default(now())
    createdBy           String?
    updatedAt           DateTime @updatedAt
    updatedBy           String?

    website             Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
    components          PageComponent[]

    @@unique([websiteId, slug])
}

model PageComponent {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    key                String   @unique
    webpageId          String
    componentId        String
    order              Int

    createdAt          DateTime @default(now())
    createdBy          String?
    updatedAt          DateTime @updatedAt
    updatedBy          String?
    
    webpage            Webpage   @relation(fields: [webpageId], references: [id], onDelete: Cascade)
    component          Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
    
    values             ComponentFieldValue[]
}

model Component {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    key                String   @unique
    name               String
    description        String

    createdAt          DateTime? @default(now())
    createdBy          String?
    updatedAt          DateTime? @updatedAt
    updatedBy          String?

    fields              ComponentField[]
    pages              PageComponent[]
}

model ComponentField {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    componentId        String
    key                String   
    label              String
    type               FieldType
    required           Boolean @default(false)
    minLength          Int?
    maxLength          Int?
    minValue           Float?
    maxValue           Float?
    regex              String?
    component          Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

    createdAt          DateTime? @default(now())
    createdBy          String?
    updatedAt          DateTime? @updatedAt
    updatedBy          String?

    fieldValues         ComponentFieldValue[]
    itemSchema         ItemSchema[]

    @@unique([componentId, key])
}

model ItemSchema {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    componentFieldId   String
    label              String
    key                String
    type               FieldType
    required           Boolean @default(false)

    createdAt          DateTime @default(now())
    createdBy          String?
    updatedAt          DateTime @updatedAt
    updatedBy          String?
    
    componentField     ComponentField @relation(fields: [componentFieldId], references: [id], onDelete: Cascade)
}

model ComponentFieldValue {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    pageComponentId    String
    fieldId             String
    value              Json

    createdAt          DateTime @default(now())
    createdBy          String?
    updatedAt          DateTime @updatedAt
    updatedBy          String?

    pageComponent      PageComponent @relation(fields: [pageComponentId], references: [id], onDelete: Cascade)
    field               ComponentField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

    @@unique([pageComponentId, fieldId])
}