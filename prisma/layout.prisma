model Website {
    id                  String   @id @default(dbgenerated("gen_random_uuid()"))
    name                String
    description         String
    domain              String
    version             Int      @default(1)
    createdAt           DateTime @default(now())
    createdBy           String
    updatedAt           DateTime @updatedAt
    updatedBy           String

    pages               Webpage[]
}

model Webpage {
    id                  String   @id @default(dbgenerated("gen_random_uuid()"))
    websiteId           String
    slug                String
    
    createdAt           DateTime @default(now())
    createdBy           String?
    updatedAt           DateTime @updatedAt
    updatedBy           String?

    website             Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
    components          PageComponent[]

    @@unique([websiteId, slug])
}

model PageComponent {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    key                String   @unique
    webpageId          String
    componentId        String
    order              Int

    createdAt          DateTime @default(now())
    createdBy          String?
    updatedAt          DateTime @updatedAt
    updatedBy          String?
    
    webpage            Webpage   @relation(fields: [webpageId], references: [id], onDelete: Cascade)
    component          Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
    
    values             ComponentFieldValue[]
}

model Component {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    key                String   @unique
    name               String
    description        String

    createdAt          DateTime? @default(now())
    createdBy          String?
    updatedAt          DateTime? @updatedAt
    updatedBy          String?

    fields              ComponentField[]
    pages              PageComponent[]
}

model ComponentField {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    componentId        String
    key                String   
    label              String
    type               FieldType
    referenceType      ReferenceType?
    required           Boolean @default(false)
    minLength          Int?
    maxLength          Int?
    minValue           Float?
    maxValue           Float?
    regex              String?
    schemaId           String?

    createdAt          DateTime? @default(now())
    createdBy          String?
    updatedAt          DateTime? @updatedAt
    updatedBy          String?

    fieldValues         ComponentFieldValue[]
    itemSchema         ItemSchema[]

    component          Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

    @@unique([componentId, key])
}

model ItemSchema {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    componentFieldId   String
    label              String
    key                String
    type               FieldType
    required           Boolean @default(false)
    parentId           String?

    createdAt          DateTime @default(now())
    createdBy          String?
    updatedAt          DateTime @updatedAt
    updatedBy          String?
    
    componentField    ComponentField @relation(fields: [componentFieldId], references: [id], onDelete: Cascade)
    parent            ItemSchema? @relation("ItemSchemaChildren", fields: [parentId], references: [id], onDelete: Cascade)
    children          ItemSchema[] @relation("ItemSchemaChildren")
}

model ObjectSchema {
    id          String   @id @default(dbgenerated("gen_random_uuid()"))
    key         String   @unique
    name        String
    description String?

    createdAt   DateTime @default(now())
    createdBy   String?
    updatedAt   DateTime @updatedAt
    updatedBy   String?

    fields      ObjectSchemaField[]

    objectSchemaFields ObjectSchemaField[] @relation("NestedSchema")
}

model ObjectSchemaField {
    id              String   @id @default(dbgenerated("gen_random_uuid()"))

    objectSchemaId  String

    key             String
    label           String

    type            FieldType
    required        Boolean @default(false)

    referenceType   ReferenceType?

    schemaId        String?

    minLength       Int?
    maxLength       Int?
    minValue        Float?
    maxValue        Float?
    regex           String?

    objectSchema    ObjectSchema @relation(fields: [objectSchemaId], references: [id], onDelete: Cascade)
    objectSchemaFields ObjectSchemaField[] @relation("NestedSchema")


    nestedSchema    ObjectSchema? @relation("NestedSchema", fields: [schemaId], references: [id])
    usedBy          ObjectSchemaField[] @relation("NestedSchema")

    @@unique([objectSchemaId, key])
}

model ComponentFieldValue {
    id                 String   @id @default(dbgenerated("gen_random_uuid()"))
    pageComponentId    String
    fieldId             String
    value              Json

    createdAt          DateTime @default(now())
    createdBy          String?
    updatedAt          DateTime @updatedAt
    updatedBy          String?

    pageComponent      PageComponent @relation(fields: [pageComponentId], references: [id], onDelete: Cascade)
    field               ComponentField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

    @@unique([pageComponentId, fieldId])
}