model User {
    id          String   @id @default(dbgenerated("gen_random_uuid()"))
    email       String   @unique
    username    String   @unique
    displayName String
    isActive    Boolean  @default(true)
    isLocked    Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    lastLoginAt DateTime?
    locale      String   @default("en-US")
    timezone    String   @default("UTC")
    deletedAt   DateTime?

    identities   UserIdentity[]
    credential   UserCredential?
    userMFAs     UserMFA[]
    notification  NotificationPreference?
}

model UserIdentity {
    id              Int      @id @default(autoincrement())
    userId          String
    providerId      Int
    providerUserId  String
    emailAtProvider String
    profileJson      Json
    createdAt       DateTime @default(now())

    user          User             @relation(fields: [userId], references: [id])
    provider      IdentityProvider @relation(fields: [providerId], references: [id])
}

model UserCredential {
    id                  String   @id @default(dbgenerated("gen_random_uuid()"))
    userId              String   @unique
    passwordHash        String
    passwordAlgo        String
    passwordUpdatedAt   DateTime @default(now())
    passwordVersion     Int      @default(1)

    user                User     @relation(fields: [userId], references: [id])
}

model UserCredentialWebAuthn {
    id              Int      @id @default(autoincrement())
    userId          String
    credentialId    String   @unique
    publicKey       String
    signCount       Int
    transports      String
    createdAt       DateTime @default(now())
    attestationFmt  String
    updatedAt       DateTime @updatedAt
}

model UserMFA {
    id              Int      @id @default(autoincrement())
    userId          String
    method          MFAMethod
    secret          String
    isEnabled       Boolean  @default(false)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user            User     @relation(fields: [userId], references: [id])
}

model OAuthToken {
    id              Int      @id @default(autoincrement())
    userIdentityId  String
    accessToken     Int
    refreshToken    String
    expiresAt       DateTime
    scope           String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

}

model EmailVerification {
    id          Int      @id @default(autoincrement())
    userId      String
    token       String   @unique
    sentAt      DateTime @default(now())
    consumedAt  DateTime?
    expiresAt   DateTime
    createdAt   DateTime @default(now())


}

model PasswordReset {
    id          Int      @id @default(autoincrement())
    userId      String
    token       String   @unique
    sentAt      DateTime @default(now())
    consumedAt  DateTime?
    expiresAt   DateTime
}

model AuthEvent {
    id          Int      @id @default(autoincrement())
    userId      String
    eventType   AuthEventType
    ipAddress   String
    userAgent   String
    occurredAt  DateTime @default(now())
    metadata    Json?
}

model NotificationPreference {
    id                    String   @id @default(dbgenerated("gen_random_uuid()"))
    userId                String   @unique
    pushNotifications      Boolean  @default(true)
    monthlyNewsletter     Boolean  @default(true)
    vacancies             Boolean  @default(true)
    dataInsights          Boolean  @default(true)
    productAnnouncements  Boolean  @default(true)
    specialOffers         Boolean  @default(true)
    eventInvitations      Boolean  @default(true)
    projectUpdates        Boolean  @default(true)
    subscriptionReminders Boolean  @default(true)

    user                  User           @relation(fields: [userId], references: [id])
}