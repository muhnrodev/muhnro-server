model User {
    id                     String   @id @default(dbgenerated("gen_random_uuid()"))
    email                  String   @unique
    username               String   @unique
    displayName            String
    isActive               Boolean  @default(true)
    isLocked               Boolean  @default(false)
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt
    lastLoginAt            DateTime?
    locale                 String   @default("en-US")
    timezone               String   @default("UTC")
    deletedAt              DateTime?
    role                   UserRole @default(USER)

    identities             UserIdentity[]
    credential             UserCredential?
    userMFAs               UserMFA[]
    privacy                PrivacySettings?
    notification            NotificationPreference?
    promotionalNotification PromotionalPreference?
    insightsNotification    InsightsPreference?
    sessions               Session[]
}



model UserCredentialWebAuthn {
    id              Int      @id @default(autoincrement())
    userId          String
    credentialId    String   @unique
    publicKey       String
    signCount       Int
    transports      String
    createdAt       DateTime @default(now())
    attestationFmt  String
    updatedAt       DateTime @updatedAt
}

model UserMFA {
    id              Int      @id @default(autoincrement())
    userId          String
    method          MFAMethod
    secret          String
    isEnabled       Boolean  @default(false)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user            User     @relation(fields: [userId], references: [id])
}

model OAuthToken {
    id              Int      @id @default(autoincrement())
    userIdentityId  String
    accessToken     Int
    refreshToken    String
    expiresAt       DateTime
    scope           String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

}

model EmailVerification {
    id          Int      @id @default(autoincrement())
    userId      String
    token       String   @unique
    sentAt      DateTime @default(now())
    consumedAt  DateTime?
    expiresAt   DateTime
    createdAt   DateTime @default(now())


}

model PasswordReset {
    id          Int      @id @default(autoincrement())
    userId      String
    token       String   @unique
    sentAt      DateTime @default(now())
    consumedAt  DateTime?
    expiresAt   DateTime
}

model AuthEvent {
    id          Int      @id @default(autoincrement())
    userId      String
    eventType   AuthEventType
    ipAddress   String
    userAgent   String
    occurredAt  DateTime @default(now())
    metadata    Json?
}


model PrivacySettings {
    id                   String   @id @default(dbgenerated("gen_random_uuid()"))
    userId               String   @unique
    trackUserBehavior    Boolean 
    essentialCookies     Boolean
    performanceCookies   Boolean
    functionalCookies    Boolean
    advertisingCookies   Boolean
    thirdPartyCookies    Boolean
    socialMediaCookies   Boolean
    preferenceCookies    Boolean

    user              User     @relation(fields: [userId], references: [id])
}