model Project {
    id                   String         @id @default(dbgenerated("gen_random_uuid()"))
    code                 String
    slug                 String         @unique
    title                String
    subtitle             String?
    description          String?        @db.Text
    clientId             String
    industryId           String
    startDate            DateTime
    endDate              DateTime?
    story                String
    locationId           String
    projectLeadId        String
    budget               Float
    status               ProjectStatus  @default(ACTIVE)
    serviceSummary       String

    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    client               Client         @relation(fields: [clientId], references: [id])
    industry             Industry       @relation(fields: [industryId], references: [industryId])
    location             Location       @relation(fields: [locationId], references: [locationId])
    projectLead          TeamMember     @relation(fields: [projectLeadId], references: [id])

    teamMembers          ProjectTeamMember[]
    stakeholders         ProjectStakeholder[]
    tags                 ProjectTag[]
    images               ProjectImage[]
    notes                ProjectNote[]


    // serviceActivities   ProjectServiceActivity[]
    // articles            Article[]
}

model ProjectStakeholder {
    id                     String   @id @default(dbgenerated("gen_random_uuid()"))
    projectId              String
    stakeholderId          String

    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt

    project                Project     @relation(fields: [projectId], references: [id])
    stakeholder            Stakeholder @relation(fields: [stakeholderId], references: [stakeholderId])
}

