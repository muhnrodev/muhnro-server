model Project {
    id            String   @id @default(dbgenerated("gen_random_uuid()"))
    code          String
    title         String
    description   String
    clientId      String
    industryId    String
    locationId    String
    projectLeadId String
    startDate     DateTime
    endDate       DateTime?
    status        ProjectStatus  @default(ACTIVE)
    serviceSummary    String
    budget            Float
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    client          Client           @relation(fields: [clientId], references: [id])
    industry        Industry         @relation(fields: [industryId], references: [industryId])
    location        Location         @relation(fields: [locationId], references: [locationId])
    projectLead     TeamMember       @relation(fields: [projectLeadId], references: [memberId])

    serviceActivities   ProjectServiceActivity[]
    teamMembers         ProjectTeamMember[]
    images              ProjectImage[]
    notes               ProjectNote[]
    articles            Article[]
}

model ProjectServiceActivity {
    projectActivityId String   @id @default(dbgenerated("gen_random_uuid()"))
    projectId         String
    activityId        String
    notes             String?
    createdAt         DateTime @default(now())

    project           Project        @relation(fields: [projectId], references: [id])
    serviceActivity   ServiceActivity @relation(fields: [activityId], references: [activityId])
}

model ProjectTeamMember {
    projectMemberId   String   @id @default(dbgenerated("gen_random_uuid()"))
    projectId         String
    memberId          String
    roleId            String
    assignedDate      DateTime @default(now())
    unassignedDate    DateTime?
    allocationPercent Float
    notes             String?
    createdAt         DateTime @default(now())

    project           Project      @relation(fields: [projectId], references: [id])
    teamMember        TeamMember   @relation(fields: [memberId], references: [memberId])
    teamRole          TeamRole     @relation(fields: [roleId], references: [roleId])
}

model ProjectImage {
    imageId      String   @id @default(dbgenerated("gen_random_uuid()"))
    projectId    String
    fileName      String
    url          String
    binaryHash   String
    mimeType     String
    size         Int
    takenAt      DateTime?
    photographer String?
    gpsLat       Float?
    gpsLong      Float?
    caption      String?
    tags         String

    project      Project   @relation(fields: [projectId], references: [id])
}

model ProjectNote {
    noteId      String   @id @default(dbgenerated("gen_random_uuid()"))
    projectId   String
    authorId    String
    noteType    NoteType
    body        String
    createdAt   DateTime @default(now())

    project     Project  @relation(fields: [projectId], references: [id])
    author      TeamMember @relation(fields: [authorId], references: [memberId])
}